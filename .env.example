# Application connection (enable pooling in Neon's Connect dialog).
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Optional: direct URL for migrations. If absent, Prisma configuration derives
# Neon's direct hostname from DATABASE_URL. Supply explicitly for other providers.
# DIRECT_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require"

# Generate a unique random secret of at least 32 characters for each environment.
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
BETTER_AUTH_URL="http://localhost:3000"

# Fixed session lifetime in seconds (7 days). No sliding refresh.
AUTH_SESSION_TTL_SECONDS="604800"

# Local testing only. Production refuses this delivery mode.
AUTH_SMS_MODE="development"

# To send real messages, set AUTH_SMS_MODE="smsethiopia" and add your campaign key.
# The free test campaign sends only to numbers verified in the provider dashboard.
SMSETHIOPIA_API_KEY=""

# Temporary admin wallet credits. Only works in local development; disable later.
ADMIN_TEST_FUNDING_ENABLED="false"
