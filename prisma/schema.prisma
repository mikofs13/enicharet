generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum AuctionStatus {
  DRAFT
  SCHEDULED
  OPEN
  CLOSING
  AWAITING_PAYMENT
  WINNER_CONFIRMED
  REFUNDING
  CANCELLED
  FULFILLED
  REFUNDED
}

model User {
  id                  String     @id @default(cuid())
  email               String?    @unique
  phoneNumber         String?    @unique(map: "User_phone_key") @map("phone")
  phoneNumberVerified Boolean    @default(false)
  name                String?
  emailVerified       Boolean    @default(false)
  image               String?
  role                UserRole   @default(USER)
  status              UserStatus @default(ACTIVE)
  createdAt           DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @db.Timestamptz(3)
  sessions            Session[]
  accounts            Account[]
  wallet              WalletAccount?
  bids                Bid[]
  creditsIssued       AdminWalletCredit[] @relation("CreditActor")
  creditsReceived     AdminWalletCredit[] @relation("CreditRecipient")
  notificationEvents  NotificationOutbox[]
  notifications       Notification[]
  operationRetries    OperationRetryAudit[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Auction {
  id                   String         @id @default(cuid())
  slug                 String         @unique
  title                String
  description          String
  status               AuctionStatus  @default(DRAFT)
  // All monetary amounts are integer hundredths of a birr.
  entryFeeMinor        Int
  maxBidsPerUser       Int?
  paymentWindowSeconds Int
  opensAt              DateTime       @db.Timestamptz(3)
  closesAt             DateTime       @db.Timestamptz(3)
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @db.Timestamptz(3)
  images               AuctionImage[]
  bids                 Bid[]
  settlement           AuctionSettlement?
  settlementJob        SettlementJob?
  offers               WinnerOffer[]
  notificationEvents   NotificationOutbox[]

  @@index([status, opensAt])
  @@index([status, closesAt])
}

model AuctionImage {
  id        String  @id @default(cuid())
  auctionId String
  url       String
  alt       String
  position  Int     @default(0)
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@unique([auctionId, position])
}

enum WalletAccountKind {
  USER
  TEST_CLEARING
  TEST_FEES
  TEST_PRIZE
}

enum WalletTransferKind {
  TEST_CREDIT
  TEST_DEBIT
  REVERSAL
  BID_FEE
  WINNER_PAYMENT
}

// TEST accounts only. Live payments need a separate, reviewed money environment.
model WalletAccount {
  id           String            @id @default(cuid())
  key          String            @unique
  userId       String?           @unique
  user         User?             @relation(fields: [userId], references: [id], onDelete: Restrict)
  kind         WalletAccountKind
  currency     String            @default("ETB")
  mode         String            @default("TEST")
  balanceMinor BigInt            @default(0)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  outgoing     WalletTransfer[]   @relation("TransferSource")
  incoming     WalletTransfer[]   @relation("TransferDestination")
}

// One immutable row represents equal debit/credit entries, in the same currency.
// SQL triggers apply the balance projection; application code cannot edit it.
model WalletTransfer {
  id                   String             @id @default(cuid())
  operationKey         String             @unique
  kind                 WalletTransferKind
  amountMinor          BigInt
  description          String
  sourceId             String
  destinationId        String
  source               WalletAccount      @relation("TransferSource", fields: [sourceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  destination          WalletAccount      @relation("TransferDestination", fields: [destinationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reversalOfId         String?            @unique
  reversalOf           WalletTransfer?    @relation("TransferReversal", fields: [reversalOfId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reversal             WalletTransfer?    @relation("TransferReversal")
  bid                  Bid?
  winnerPayment        WinnerOffer?
  adminCredit          AdminWalletCredit?
  createdAt            DateTime           @default(now()) @db.Timestamptz(3)

  @@index([sourceId, createdAt, id])
  @@index([destinationId, createdAt, id])
}

// Retained after the temporary funding UI is removed.
model AdminWalletCredit {
  id           String @id @default(cuid())
  operationKey String @unique
  actorId      String
  recipientId  String
  transferId   String @unique
  reason       String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  actor        User @relation("CreditActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recipient    User @relation("CreditRecipient", fields: [recipientId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  transfer     WalletTransfer @relation(fields: [transferId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([createdAt, id])
}

model Bid {
  id            String         @id @default(cuid())
  userId        String
  auctionId     String
  amountMinor   Int
  entryFeeMinor Int
  operationKey  String         @unique
  feeTransferId String         @unique
  mode          String         @default("TEST")
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  auction       Auction        @relation(fields: [auctionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  feeTransfer   WalletTransfer @relation(fields: [feeTransferId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  candidate     SettlementCandidate?

  @@unique([auctionId, userId, amountMinor])
  @@index([userId, createdAt, id])
  @@index([auctionId, amountMinor])
}

enum WinnerOfferState {
  PENDING
  EXPIRED
  PAID
}

model SettlementJob {
  auctionId   String   @id
  auction     Auction  @relation(fields: [auctionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  nextRunAt   DateTime @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  attempts    Int      @default(0)
  lastError   String?
  retries     OperationRetryAudit[]

  @@index([completedAt, nextRunAt])
}

model AuctionSettlement {
  auctionId     String   @id
  auction       Auction  @relation(fields: [auctionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  snapshotAt    DateTime @default(now()) @db.Timestamptz(3)
  transactionId BigInt   @default(dbgenerated("txid_current()"))
  candidates    SettlementCandidate[]
}

model SettlementCandidate {
  id         String            @id @default(cuid())
  auctionId  String
  settlement AuctionSettlement @relation(fields: [auctionId], references: [auctionId], onDelete: Restrict, onUpdate: Restrict)
  bidId      String            @unique
  bid        Bid               @relation(fields: [bidId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rank       Int
  offer      WinnerOffer?

  @@unique([auctionId, rank])
}

model WinnerOffer {
  id                String              @id @default(cuid())
  auctionId         String
  auction           Auction             @relation(fields: [auctionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  candidateId       String              @unique
  candidate         SettlementCandidate @relation(fields: [candidateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  state             WinnerOfferState    @default(PENDING)
  offeredAt         DateTime            @default(now()) @db.Timestamptz(3)
  expiresAt         DateTime            @db.Timestamptz(3)
  paidAt            DateTime?           @db.Timestamptz(3)
  paymentTransferId String?             @unique
  paymentTransfer   WalletTransfer?     @relation(fields: [paymentTransferId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([auctionId, state])
  @@index([state, expiresAt])
}

enum NotificationKind {
  OFFER_CREATED
  OFFER_EXPIRED
  WINNER_CONFIRMED
  REFUND_COMPLETED
}

model NotificationOutbox {
  id            String @id @default(cuid())
  eventKey      String @unique
  userId        String
  auctionId     String
  kind          NotificationKind
  title         String
  body          String
  href          String
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  nextAttemptAt DateTime @default(now()) @db.Timestamptz(3)
  attempts      Int @default(0)
  deliveredAt   DateTime? @db.Timestamptz(3)
  lastError     String?
  user          User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  auction       Auction @relation(fields: [auctionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  notification  Notification?
  retries       OperationRetryAudit[]

  @@index([deliveredAt, nextAttemptAt])
  @@index([userId, createdAt])
}

model Notification {
  id        String @id @default(cuid())
  eventId   String @unique
  userId    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  readAt    DateTime? @db.Timestamptz(3)
  event     NotificationOutbox @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user      User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, createdAt, id])
  @@index([userId, readAt])
}

model WorkerHeartbeat {
  name       String @id
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)
}

enum OperationRetryKind {
  SETTLEMENT
  NOTIFICATION
}

model OperationRetryAudit {
  id                  String @id @default(cuid())
  operationKey        String @unique
  actorId             String
  kind                OperationRetryKind
  settlementJobId     String?
  notificationEventId String?
  expectedAttempts    Int
  reason              String
  previousRunAt       DateTime @db.Timestamptz(3)
  scheduledFor        DateTime @db.Timestamptz(3)
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  actor               User @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  settlementJob       SettlementJob? @relation(fields: [settlementJobId], references: [auctionId], onDelete: Restrict, onUpdate: Restrict)
  notificationEvent   NotificationOutbox? @relation(fields: [notificationEventId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([settlementJobId, expectedAttempts])
  @@unique([notificationEventId, expectedAttempts])
  @@index([createdAt, id])
}
