generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum AuctionStatus {
  DRAFT
  SCHEDULED
  OPEN
  CLOSING
  AWAITING_PAYMENT
  WINNER_CONFIRMED
  REFUNDING
  CANCELLED
  FULFILLED
}

model User {
  id                  String     @id @default(cuid())
  email               String?    @unique
  phoneNumber         String?    @unique(map: "User_phone_key") @map("phone")
  phoneNumberVerified Boolean    @default(false)
  name                String?
  emailVerified       Boolean    @default(false)
  image               String?
  role                UserRole   @default(USER)
  status              UserStatus @default(ACTIVE)
  createdAt           DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @db.Timestamptz(3)
  sessions            Session[]
  accounts            Account[]
  wallet              WalletAccount?
  bids                Bid[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Auction {
  id                   String         @id @default(cuid())
  slug                 String         @unique
  title                String
  description          String
  status               AuctionStatus  @default(DRAFT)
  // All monetary amounts are integer hundredths of a birr.
  entryFeeMinor        Int
  maxBidsPerUser       Int?
  paymentWindowSeconds Int
  opensAt              DateTime       @db.Timestamptz(3)
  closesAt             DateTime       @db.Timestamptz(3)
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @db.Timestamptz(3)
  images               AuctionImage[]
  bids                 Bid[]

  @@index([status, opensAt])
  @@index([status, closesAt])
}

model AuctionImage {
  id        String  @id @default(cuid())
  auctionId String
  url       String
  alt       String
  position  Int     @default(0)
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@unique([auctionId, position])
}

enum WalletAccountKind {
  USER
  TEST_CLEARING
  TEST_FEES
}

enum WalletTransferKind {
  TEST_CREDIT
  TEST_DEBIT
  REVERSAL
  BID_FEE
}

// TEST accounts only. Live payments need a separate, reviewed money environment.
model WalletAccount {
  id           String            @id @default(cuid())
  key          String            @unique
  userId       String?           @unique
  user         User?             @relation(fields: [userId], references: [id], onDelete: Restrict)
  kind         WalletAccountKind
  currency     String            @default("ETB")
  mode         String            @default("TEST")
  balanceMinor BigInt            @default(0)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  outgoing     WalletTransfer[]   @relation("TransferSource")
  incoming     WalletTransfer[]   @relation("TransferDestination")
}

// One immutable row represents equal debit/credit entries, in the same currency.
// SQL triggers apply the balance projection; application code cannot edit it.
model WalletTransfer {
  id                   String             @id @default(cuid())
  operationKey         String             @unique
  kind                 WalletTransferKind
  amountMinor          BigInt
  description          String
  sourceId             String
  destinationId        String
  source               WalletAccount      @relation("TransferSource", fields: [sourceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  destination          WalletAccount      @relation("TransferDestination", fields: [destinationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reversalOfId         String?            @unique
  reversalOf           WalletTransfer?    @relation("TransferReversal", fields: [reversalOfId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reversal             WalletTransfer?    @relation("TransferReversal")
  bid                  Bid?
  createdAt            DateTime           @default(now()) @db.Timestamptz(3)

  @@index([sourceId, createdAt, id])
  @@index([destinationId, createdAt, id])
}

model Bid {
  id            String         @id @default(cuid())
  userId        String
  auctionId     String
  amountMinor   Int
  entryFeeMinor Int
  operationKey  String         @unique
  feeTransferId String         @unique
  mode          String         @default("TEST")
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  auction       Auction        @relation(fields: [auctionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  feeTransfer   WalletTransfer @relation(fields: [feeTransferId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([auctionId, userId, amountMinor])
  @@index([userId, createdAt, id])
  @@index([auctionId, amountMinor])
}
